# Copy this file to config/local.env and fill in local values.
# config/local.env is intentionally ignored by git.
#
# This is the single local secrets/config file for connector tests and local runs.

# Enable live connector pytest tests.
# Leave as 0 unless you intentionally want live tests to run.
MOOMAIL_RUN_LIVE_CONNECTOR_TESTS=0

# OpenAI Responses API connector test.
MOOMAIL_OPENAI_API_KEY=
MOOMAIL_OPENAI_MODEL=
MOOMAIL_OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini generateContent connector test.
MOOMAIL_GEMINI_API_KEY=
MOOMAIL_GEMINI_MODEL=
MOOMAIL_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Portfolio Agent LLM provider. Supported values: gemini, openai.
# The agent is provider-neutral; Gemini is the current default.
MOOMAIL_PORTFOLIO_AGENT_LLM_PROVIDER=gemini

# Pinecone connector tests.
MOOMAIL_PINECONE_API_KEY=
MOOMAIL_PINECONE_INDEX_HOST=
MOOMAIL_PINECONE_NAMESPACE=moomail-connector-smoke
MOOMAIL_PINECONE_VECTOR_DIMENSION=8

# Neo4j connector test.
MOOMAIL_NEO4J_URI=http://localhost:7474
MOOMAIL_NEO4J_USERNAME=neo4j
MOOMAIL_NEO4J_PASSWORD=
MOOMAIL_NEO4J_DATABASE=neo4j

# OpenD is a local gateway connection, not a normal REST API key flow.
# The default OpenD listener is usually 127.0.0.1:11111.

MOOMAIL_OPEND_HOST=127.0.0.1
MOOMAIL_OPEND_PORT=11111
MOOMAIL_OPEND_CONNECTION_TIMEOUT_SECONDS=2.0

# auto means the SDK follows the OpenD encryption setting.
# Use true/false only when you intentionally want to force encryption on/off.
MOOMAIL_OPEND_IS_ENCRYPT=auto

# Optional. Use only if you configure RSA encryption in OpenD and the SDK.
MOOMAIL_OPEND_RSA_PRIVATE_KEY_PATH=

# Compatibility setting used before importing the moomoo SDK.
# Leave as python unless you know your protobuf/moomoo-api versions are compatible.
MOOMAIL_PROTOBUF_IMPLEMENTATION=python

# For US equities, FUTUINC + US is the default assumption.
# Use FUTUSG if that is the security firm configured in your OpenD session.
MOOMAIL_MOOMOO_SECURITY_FIRM=FUTUINC
MOOMAIL_MOOMOO_TRADE_MARKET=US
MOOMAIL_MOOMOO_TRADE_ENV=REAL
MOOMAIL_MOOMOO_BASE_CURRENCY=USD

# Prefer account id after you discover it through the account-list call.
# If blank, account index is used as a fallback.
MOOMAIL_MOOMOO_ACCOUNT_ID=
MOOMAIL_MOOMOO_ACCOUNT_INDEX=0
